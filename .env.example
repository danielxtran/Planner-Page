# Copy this file to .env.local and fill in your own IDs (see docs/calendar-setup.md).
# These are PUBLIC client IDs, not secrets: they are built into the page on purpose.
# Never put a client *secret* here; this app doesn't use one.

# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application)
VITE_GOOGLE_CLIENT_ID=

# Microsoft Entra admin center > App registrations > your app > Application (client) ID
VITE_MICROSOFT_CLIENT_ID=
